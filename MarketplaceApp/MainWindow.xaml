<Window x:Class="MarketplaceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Маркетплейс товаров"
        Height="720" Width="1200"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Icon="/images/app.ico"
        FontFamily="{DynamicResource MainFont}"
        Background="{DynamicResource BrushSurface}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0" Background="{DynamicResource BrushPrimary}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnBack" Grid.Column="0"
                        Content="← Назад"
                        Style="{DynamicResource HeaderButton}"
                        ToolTip="Вернуться на предыдущую страницу"
                        Click="BtnBack_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="/images/logo.png" Width="38" Height="38" Margin="0,0,10,0"
                           ToolTip="Маркетплейс товаров"/>
                    <TextBlock x:Name="TitleText"
                               Text="Маркетплейс товаров"
                               Foreground="{DynamicResource BrushOnPrimary}"
                               FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnTheme"
                            Content="Сменить тему"
                            Style="{DynamicResource HeaderButton}"
                            ToolTip="Переключить оформление: бело-синее / бело-зелёное"
                            Click="BtnTheme_Click"/>
                    <Button x:Name="BtnLogout"
                            Content="Выйти"
                            Style="{DynamicResource HeaderButton}"
                            ToolTip="Выйти из учётной записи"
                            Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        
        <Frame x:Name="MainFrame" Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Navigated="MainFrame_Navigated"/>

        
        <Border Grid.Row="2" Background="{DynamicResource BrushBackground}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="UserInfo"
                           Margin="12,0"
                           FontSize="13"
                           Foreground="{DynamicResource BrushText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="DateTimeNow"
                           Margin="12,0"
                           FontSize="13"
                           Foreground="{DynamicResource BrushText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           ToolTip="Текущие дата и время"/>
            </Grid>
        </Border>
    </Grid>
</Window>
