<Page x:Class="MarketplaceApp.Pages.AddProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:classes="clr-namespace:MarketplaceApp.Classes"
      Title="Товар">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{DynamicResource Card}" Width="900" Margin="20" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{DynamicResource TitleText}" HorizontalAlignment="Center"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Продавец *" Style="{DynamicResource FieldLabel}"/>
                        <ComboBox x:Name="CBSeller" Grid.Row="0" Grid.Column="1"
                                  DisplayMemberPath="ShopName" SelectedValuePath="SellerId"
                                  SelectedValue="{Binding SellerId}" ToolTip="Магазин, который продаёт товар"/>

                        <TextBlock Grid.Row="1" Text="Категория *" Style="{DynamicResource FieldLabel}"/>
                        <ComboBox x:Name="CBCategory" Grid.Row="1" Grid.Column="1"
                                  DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId"
                                  SelectedValue="{Binding CategoryId}" ToolTip="Выберите категорию товара"/>

                        <TextBlock Grid.Row="2" Text="Артикул *" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="TBArticle" Grid.Row="2" Grid.Column="1"
                                 Text="{Binding Article, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Например: MP-010013" ToolTip="Уникальный артикул: латинские буквы, цифры, дефис"
                                 MaxLength="20" classes:InputMask.Mode="Latin"/>

                        <TextBlock Grid.Row="3" Text="Название *" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="TBName" Grid.Row="3" Grid.Column="1"
                                 Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Например: Смартфон Galaxy A55" ToolTip="Название товара" MaxLength="150"/>

                        <TextBlock Grid.Row="4" Text="Бренд *" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="TBBrand" Grid.Row="4" Grid.Column="1"
                                 Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Например: Samsung" ToolTip="Бренд (производитель)" MaxLength="50"/>

                        <TextBlock Grid.Row="5" Text="Описание" Style="{DynamicResource FieldLabel}" VerticalAlignment="Top"/>
                        <TextBox x:Name="TBDescription" Grid.Row="5" Grid.Column="1"
                                 Style="{DynamicResource MultiLineTextBox}"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Характеристики товара" ToolTip="Описание товара (до 1000 символов)" MaxLength="1000"/>

                        <TextBlock Grid.Row="6" Text="Цена, руб. *" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="TBPrice" Grid.Row="6" Grid.Column="1"
                                 Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="От 1 до 10 000 000" ToolTip="Цена без скидки: от 1 до 10 000 000 руб."
                                 MaxLength="11" classes:InputMask.Mode="Decimal"/>

                        <TextBlock Grid.Row="7" Text="Скидка, % *" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="TBDiscount" Grid.Row="7" Grid.Column="1"
                                 Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="От 0 до 90" ToolTip="Скидка от 0 до 90 %"
                                 MaxLength="2" classes:InputMask.Mode="Digits"/>

                        <TextBlock Grid.Row="8" Text="Остаток, шт. *" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="TBStock" Grid.Row="8" Grid.Column="1"
                                 Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="От 0 до 100 000" ToolTip="Количество на складе: от 0 до 100 000"
                                 MaxLength="6" classes:InputMask.Mode="Digits"/>

                        <TextBlock Grid.Row="9" Text="Модерация" Style="{DynamicResource FieldLabel}"/>
                        <ComboBox x:Name="CBModeration" Grid.Row="9" Grid.Column="1"
                                  SelectedItem="{Binding ModerationStatus}"
                                  ToolTip="Статус проверки товара модератором"/>

                        <CheckBox Grid.Row="10" Grid.Column="1" Content="Товар активен (продаётся)"
                                  IsChecked="{Binding IsActive}"
                                  ToolTip="Неактивные товары не показываются в каталоге"/>
                    </Grid>

                    
                    
                    <StackPanel Grid.Column="1" Margin="12,6,0,0">
                        <TextBlock Text="Фото товара" Style="{DynamicResource FieldLabel}"/>
                        <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8"
                                Margin="6" Height="190" Background="{DynamicResource BrushBackground}">
                            <Image x:Name="PhotoImage" Stretch="Uniform" Margin="6"
                                   ToolTip="Так фото будет выглядеть в каталоге"/>
                        </Border>
                        <Button x:Name="ButtonPhoto" Content="Выбрать фото" Style="{DynamicResource SecondaryButton}"
                                ToolTip="Загрузить картинку PNG или JPG" Click="ButtonPhoto_Click"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="NoteText" Text="* — обязательные поля" Style="{DynamicResource InfoText}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="ButtonSave" Content="Сохранить" Style="{DynamicResource MainButton}"
                            ToolTip="Сохранить изменения" Click="ButtonSave_Click"/>
                    <Button x:Name="ButtonClean" Content="Очистить" Style="{DynamicResource SecondaryButton}"
                            ToolTip="Очистить поля формы" Click="ButtonClean_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
