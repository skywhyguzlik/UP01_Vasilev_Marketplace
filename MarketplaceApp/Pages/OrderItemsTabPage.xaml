<Page x:Class="MarketplaceApp.Pages.OrderItemsTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица «Состав заказов»">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource FilterBar}">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="260" Tag="Поиск по названию товара"
                         ToolTip="Введите часть названия товара" MaxLength="100"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="OrderBox" Width="300" DisplayMemberPath="DisplayName"
                          ToolTip="Показать позиции одного заказа" SelectionChanged="Filter_SelectionChanged"/>
                <ComboBox x:Name="SortBox" Width="230" SelectedIndex="0"
                          ToolTip="Порядок сортировки" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Номер заказа: по убыванию"/>
                    <ComboBoxItem Content="Номер заказа: по возрастанию"/>
                    <ComboBoxItem Content="Сумма: по убыванию"/>
                </ComboBox>
                <Button Content="Очистить фильтр" Style="{DynamicResource SecondaryButton}"
                        ToolTip="Сбросить поиск, фильтр и сортировку" Click="ClearFiltersButton_Click"/>
                <TextBlock x:Name="CountText" Style="{DynamicResource InfoText}"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="DataGridOrderItem" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ заказа" Binding="{Binding OrderId}" Width="85"/>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding Orders.OrderDate, StringFormat='dd.MM.yyyy'}" Width="105"/>
                <DataGridTextColumn Header="Покупатель" Binding="{Binding Orders.Users.FIO}" Width="*"/>
                <DataGridTextColumn Header="Товар" Binding="{Binding Products.ProductName}" Width="*"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="75"/>
                <DataGridTextColumn Header="Цена за шт." Binding="{Binding UnitPrice, StringFormat=N2}" Width="105"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding LineTotal, StringFormat=N2}" Width="105"/>
                <DataGridTemplateColumn Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Style="{DynamicResource MainButton}"
                                    ToolTip="Редактировать данные" Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{DynamicResource FilterBar}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="ButtonAdd" DockPanel.Dock="Left" Content="Добавить"
                        Style="{DynamicResource MainButton}" ToolTip="Добавить товар в заказ" Click="ButtonAdd_Click"/>
                <Button x:Name="ButtonDel" DockPanel.Dock="Right" Content="Удалить"
                        Style="{DynamicResource DangerButton}" ToolTip="Удалить выделенные позиции" Click="ButtonDel_Click"/>
                <TextBlock Style="{DynamicResource InfoText}" HorizontalAlignment="Center"
                           Text="Сумма заказа пересчитывается автоматически (триггер в базе данных)"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
