<Page x:Class="MarketplaceApp.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:classes="clr-namespace:MarketplaceApp.Classes"
      Title="Смена пароля">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{DynamicResource Card}" Width="460" Margin="20"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Смена пароля" Style="{DynamicResource TitleText}" HorizontalAlignment="Center"/>

                <TextBlock Text="Логин" Style="{DynamicResource FieldLabel}"/>
                <TextBox x:Name="TbLogin"
                         Tag="Введите логин"
                         ToolTip="Логин учётной записи"
                         MaxLength="50"
                         classes:InputMask.Mode="Latin"/>

                <TextBlock Text="Текущий пароль" Style="{DynamicResource FieldLabel}"/>
                <Grid>
                    <PasswordBox x:Name="CurrentPasswordBox" ToolTip="Введите текущий пароль" MaxLength="50"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBlock Text="Введите текущий пароль" Style="{DynamicResource HintText}"/>
                </Grid>

                <TextBlock Text="Новый пароль" Style="{DynamicResource FieldLabel}"/>
                <Grid>
                    <PasswordBox x:Name="NewPasswordBox"
                                 ToolTip="Не менее 6 символов, только английская раскладка, хотя бы одна цифра"
                                 MaxLength="50"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBlock Text="Введите новый пароль" Style="{DynamicResource HintText}"/>
                </Grid>

                <TextBlock Text="Подтверждение пароля" Style="{DynamicResource FieldLabel}"/>
                <Grid>
                    <PasswordBox x:Name="ConfirmPasswordBox" ToolTip="Повторите новый пароль" MaxLength="50"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBlock Text="Повторите новый пароль" Style="{DynamicResource HintText}"/>
                </Grid>

                <Button x:Name="ButtonSave"
                        Content="Сохранить"
                        Style="{DynamicResource MainButton}"
                        HorizontalAlignment="Center"
                        Margin="6,12,6,6"
                        ToolTip="Сохранить новый пароль"
                        Click="ButtonSave_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
