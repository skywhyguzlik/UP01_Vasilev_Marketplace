<Page x:Class="MarketplaceApp.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог товаров">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

       
        <Border Grid.Row="0" Style="{DynamicResource FilterBar}">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="280"
                         Tag="Поиск по названию или бренду"
                         ToolTip="Введите часть названия или бренда товара"
                         MaxLength="100"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="CategoryBox" Width="210"
                          DisplayMemberPath="CategoryName"
                          ToolTip="Фильтр по категории"
                          SelectionChanged="Filter_SelectionChanged"/>
                <ComboBox x:Name="SortBox" Width="230" SelectedIndex="0"
                          ToolTip="Порядок сортировки товаров"
                          SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Название: А → Я"/>
                    <ComboBoxItem Content="Название: Я → А"/>
                    <ComboBoxItem Content="Цена: по возрастанию"/>
                    <ComboBoxItem Content="Цена: по убыванию"/>
                </ComboBox>
                <CheckBox x:Name="DiscountCheck" Content="Только со скидкой"
                          ToolTip="Показать только товары со скидкой"
                          Checked="DiscountCheck_Changed" Unchecked="DiscountCheck_Changed"/>
                <Button x:Name="ClearFiltersButton" Content="Очистить фильтр"
                        Style="{DynamicResource SecondaryButton}"
                        ToolTip="Сбросить поиск, фильтры и сортировку"
                        Click="ClearFiltersButton_Click"/>
            </WrapPanel>
        </Border>

        
        <Border Grid.Row="1" Style="{DynamicResource FilterBar}">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Пункт выдачи:" Style="{DynamicResource FieldLabel}"/>
                <ComboBox x:Name="PickupBox" Width="330"
                          DisplayMemberPath="FullAddress"
                          ToolTip="Куда доставить заказ"/>
                <TextBlock Text="Оплата:" Style="{DynamicResource FieldLabel}"/>
                <ComboBox x:Name="PaymentBox" Width="200"
                          ToolTip="Способ оплаты заказа"/>
                <Button x:Name="MyOrdersButton" Content="Мои заказы"
                        Style="{DynamicResource MainButton}"
                        ToolTip="История ваших заказов и отзывы"
                        Click="MyOrdersButton_Click"/>
                <TextBlock x:Name="CountText" Style="{DynamicResource InfoText}"/>
            </WrapPanel>
        </Border>

        
        <ListView x:Name="ListProducts" Grid.Row="2"
                  HorizontalContentAlignment="Center"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource ProductCard}">
                        <StackPanel>
                            <Image Height="160" Stretch="Uniform"
                                   Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"/>
                            <TextBlock Text="{Binding ProductName}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushText}"
                                       TextWrapping="Wrap" Height="40" Margin="0,6,0,0"/>
                            <TextBlock Style="{DynamicResource InfoText}" Margin="0">
                                <Run Text="{Binding Brand, Mode=OneWay}"/>
                                <Run Text="·"/>
                                <Run Text="{Binding Categories.CategoryName, Mode=OneWay}"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding FinalPrice, StringFormat='{}{0:N2} руб.'}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushPrimary}"/>
                                <TextBlock Text="{Binding Price, StringFormat='{}{0:N0}'}"
                                           TextDecorations="Strikethrough"
                                           Foreground="{DynamicResource BrushHint}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DiscountPercent, StringFormat='Скидка {0}%'}"
                                       Foreground="{DynamicResource BrushError}" FontWeight="SemiBold"
                                       Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding StockQuantity, StringFormat='В наличии: {0} шт.'}"
                                       Style="{DynamicResource InfoText}" Margin="0"/>
                            <Button Content="Купить"
                                    Style="{DynamicResource MainButton}"
                                    IsEnabled="{Binding InStock}"
                                    ToolTip="Оформить заказ на 1 шт. этого товара"
                                    Click="BuyButton_Click"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
