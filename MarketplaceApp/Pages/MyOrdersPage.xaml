<Page x:Class="MarketplaceApp.Pages.MyOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои заказы">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource FilterBar}">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="260"
                         Tag="Поиск по товару в заказе"
                         ToolTip="Введите часть названия товара"
                         MaxLength="100"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="StatusBox" Width="210"
                          DisplayMemberPath="StatusName"
                          ToolTip="Фильтр по статусу заказа"
                          SelectionChanged="Filter_SelectionChanged"/>
                <ComboBox x:Name="SortBox" Width="230" SelectedIndex="0"
                          ToolTip="Порядок сортировки заказов"
                          SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Сначала новые"/>
                    <ComboBoxItem Content="Сначала старые"/>
                    <ComboBoxItem Content="Сумма: по убыванию"/>
                    <ComboBoxItem Content="Сумма: по возрастанию"/>
                </ComboBox>
                <Button Content="Очистить фильтр" Style="{DynamicResource SecondaryButton}"
                        ToolTip="Сбросить поиск, фильтр и сортировку"
                        Click="ClearFiltersButton_Click"/>
                <TextBlock x:Name="CountText" Style="{DynamicResource InfoText}"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="DataGridOrders" Grid.Row="1"
                  SelectionMode="Single"
                  SelectionChanged="DataGridOrders_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding OrderId}" Width="60"/>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding OrderDate, StringFormat='dd.MM.yyyy HH:mm'}" Width="140"/>
                <DataGridTextColumn Header="Пункт выдачи" Binding="{Binding PickupPoints.FullAddress}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding OrderStatuses.StatusName}" Width="110"/>
                <DataGridTextColumn Header="Оплата" Binding="{Binding PaymentMethod}" Width="150"/>
                <DataGridTextColumn Header="Сумма, руб." Binding="{Binding TotalAmount, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="Доставка" Binding="{Binding DeliveryDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="ItemsTitle"
                   Text="Состав заказа: выберите заказ в таблице выше"
                   Style="{DynamicResource SubTitleText}"/>

        <DataGrid x:Name="DataGridItems" Grid.Row="3" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding Products.ProductName}" Width="*"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="110"/>
                <DataGridTextColumn Header="Цена, руб." Binding="{Binding UnitPrice, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="Сумма, руб." Binding="{Binding LineTotal, StringFormat=N2}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" Style="{DynamicResource FilterBar}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="ReviewButton" DockPanel.Dock="Right"
                        Content="Оставить отзыв"
                        Style="{DynamicResource MainButton}"
                        ToolTip="Написать отзыв о выбранном товаре из полученного заказа"
                        Click="ReviewButton_Click"/>
                <TextBlock Style="{DynamicResource InfoText}"
                           Text="Отзыв можно оставить на товар из заказа со статусом «Получен»."/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
