<Page x:Class="MarketplaceApp.Pages.PickupPointsTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица «Пункты выдачи»">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource FilterBar}">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="280" Tag="Поиск по адресу"
                         ToolTip="Введите часть адреса пункта выдачи" MaxLength="100"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="CityBox" Width="210"
                          ToolTip="Фильтр по городу" SelectionChanged="Filter_SelectionChanged"/>
                <ComboBox x:Name="SortBox" Width="230" SelectedIndex="0"
                          ToolTip="Порядок сортировки" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Город: А → Я"/>
                    <ComboBoxItem Content="Город: Я → А"/>
                    <ComboBoxItem Content="Больше заказов"/>
                </ComboBox>
                <Button Content="Очистить фильтр" Style="{DynamicResource SecondaryButton}"
                        ToolTip="Сбросить поиск, фильтр и сортировку" Click="ClearFiltersButton_Click"/>
                <TextBlock x:Name="CountText" Style="{DynamicResource InfoText}"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="DataGridPickupPoint" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Город" Binding="{Binding City}" Width="160"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*"/>
                <DataGridTextColumn Header="Режим работы" Binding="{Binding WorkHours}" Width="130"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="160"/>
                <DataGridTextColumn Header="Заказов" Binding="{Binding Orders.Count}" Width="90"/>
                <DataGridTemplateColumn Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Style="{DynamicResource MainButton}"
                                    ToolTip="Редактировать данные" Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{DynamicResource FilterBar}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="ButtonAdd" DockPanel.Dock="Left" Content="Добавить"
                        Style="{DynamicResource MainButton}" ToolTip="Добавить данные" Click="ButtonAdd_Click"/>
                <Button x:Name="ButtonDel" DockPanel.Dock="Right" Content="Удалить"
                        Style="{DynamicResource DangerButton}" ToolTip="Удалить выделенные строки" Click="ButtonDel_Click"/>
                <TextBlock Style="{DynamicResource InfoText}" HorizontalAlignment="Center"
                           Text="Несколько строк можно выделить с зажатым Ctrl или Shift"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
