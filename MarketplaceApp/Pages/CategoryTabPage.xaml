<Page x:Class="MarketplaceApp.Pages.CategoryTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица «Категории»">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource FilterBar}">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="280" Tag="Поиск по названию или описанию"
                         ToolTip="Введите часть названия или описания категории" MaxLength="100"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="FilterBox" Width="210" SelectedIndex="0"
                          ToolTip="Фильтр по наличию товаров" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Все категории"/>
                    <ComboBoxItem Content="С товарами"/>
                    <ComboBoxItem Content="Без товаров"/>
                </ComboBox>
                <ComboBox x:Name="SortBox" Width="230" SelectedIndex="0"
                          ToolTip="Порядок сортировки" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Название: А → Я"/>
                    <ComboBoxItem Content="Название: Я → А"/>
                    <ComboBoxItem Content="Больше товаров"/>
                </ComboBox>
                <Button Content="Очистить фильтр" Style="{DynamicResource SecondaryButton}"
                        ToolTip="Сбросить поиск, фильтр и сортировку" Click="ClearFiltersButton_Click"/>
                <TextBlock x:Name="CountText" Style="{DynamicResource InfoText}"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="DataGridCategory" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="220"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Товаров" Binding="{Binding Products.Count}" Width="90"/>
                <DataGridTemplateColumn Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Style="{DynamicResource MainButton}"
                                    ToolTip="Редактировать данные" Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{DynamicResource FilterBar}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="ButtonAdd" DockPanel.Dock="Left" Content="Добавить"
                        Style="{DynamicResource MainButton}" ToolTip="Добавить данные" Click="ButtonAdd_Click"/>
                <Button x:Name="ButtonDel" DockPanel.Dock="Right" Content="Удалить"
                        Style="{DynamicResource DangerButton}" ToolTip="Удалить выделенные строки" Click="ButtonDel_Click"/>
                <TextBlock Style="{DynamicResource InfoText}" HorizontalAlignment="Center"
                           Text="Несколько строк можно выделить с зажатым Ctrl или Shift"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
