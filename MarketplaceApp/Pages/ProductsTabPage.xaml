<Page x:Class="MarketplaceApp.Pages.ProductsTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица «Товары»">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource FilterBar}">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="260" Tag="Поиск: название, бренд, артикул"
                         ToolTip="Введите часть названия, бренда или артикула" MaxLength="100"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="CategoryBox" Width="190" DisplayMemberPath="CategoryName"
                          ToolTip="Фильтр по категории" SelectionChanged="Filter_SelectionChanged"/>
                <ComboBox x:Name="StatusBox" Width="190" SelectedIndex="0"
                          ToolTip="Фильтр по статусу модерации" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Все статусы"/>
                    <ComboBoxItem Content="На модерации"/>
                    <ComboBoxItem Content="Одобрен"/>
                    <ComboBoxItem Content="Отклонён"/>
                </ComboBox>
                <ComboBox x:Name="SortBox" Width="210" SelectedIndex="0"
                          ToolTip="Порядок сортировки" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Название: А → Я"/>
                    <ComboBoxItem Content="Название: Я → А"/>
                    <ComboBoxItem Content="Цена: по возрастанию"/>
                    <ComboBoxItem Content="Цена: по убыванию"/>
                    <ComboBoxItem Content="Остаток: меньше сначала"/>
                </ComboBox>
                <Button Content="Очистить фильтр" Style="{DynamicResource SecondaryButton}"
                        ToolTip="Сбросить поиск, фильтры и сортировку" Click="ClearFiltersButton_Click"/>
                <TextBlock x:Name="CountText" Style="{DynamicResource InfoText}"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="DataGridProduct" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Фото" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="50" Height="50" Stretch="Uniform"
                                   Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="100"/>
                <DataGridTextColumn Header="Название" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Бренд" Binding="{Binding Brand}" Width="100"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Categories.CategoryName}" Width="120"/>
                <DataGridTextColumn x:Name="SellerColumn" Header="Продавец" Binding="{Binding Sellers.ShopName}" Width="110"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="Скидка, %" Binding="{Binding DiscountPercent}" Width="85"/>
                <DataGridTextColumn Header="Остаток" Binding="{Binding StockQuantity}" Width="75"/>
                <DataGridTextColumn Header="Модерация" Binding="{Binding ModerationStatus}" Width="110"/>
                <DataGridTemplateColumn Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Style="{DynamicResource MainButton}"
                                    ToolTip="Редактировать данные" Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{DynamicResource FilterBar}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="ButtonAdd" DockPanel.Dock="Left" Content="Добавить"
                        Style="{DynamicResource MainButton}" ToolTip="Добавить товар" Click="ButtonAdd_Click"/>
                <Button x:Name="ButtonDel" DockPanel.Dock="Right" Content="Удалить"
                        Style="{DynamicResource DangerButton}" ToolTip="Удалить выделенные товары" Click="ButtonDel_Click"/>
                <StackPanel x:Name="ModerationPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="ButtonApprove" Content="Одобрить" Style="{DynamicResource MainButton}"
                            ToolTip="Одобрить выделенные товары — они появятся в каталоге"
                            Click="ButtonApprove_Click"/>
                    <Button x:Name="ButtonReject" Content="Отклонить" Style="{DynamicResource SecondaryButton}"
                            ToolTip="Отклонить выделенные товары — они не будут видны покупателям"
                            Click="ButtonReject_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Page>
