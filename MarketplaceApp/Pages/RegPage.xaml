<Page x:Class="MarketplaceApp.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:classes="clr-namespace:MarketplaceApp.Classes"
      Title="Регистрация">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{DynamicResource Card}" Width="680" Margin="20"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Регистрация нового пользователя" Style="{DynamicResource TitleText}"
                           HorizontalAlignment="Center"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Логин *" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="txtbxLog" Grid.Row="0" Grid.Column="1"
                             Tag="Латинские буквы и цифры, от 3 символов"
                             ToolTip="Введите логин: латинские буквы, цифры, точка, дефис или подчёркивание"
                             MaxLength="50"
                             classes:InputMask.Mode="Latin"/>

                    <TextBlock Grid.Row="1" Text="Пароль *" Style="{DynamicResource FieldLabel}"/>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <PasswordBox x:Name="passBxFrst"
                                     ToolTip="Не менее 6 символов, только английская раскладка, хотя бы одна цифра"
                                     MaxLength="50"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                        <TextBlock x:Name="lblPassHitn" Text="Введите пароль" Style="{DynamicResource HintText}"/>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="Подтверждение пароля *" Style="{DynamicResource FieldLabel}"/>
                    <Grid Grid.Row="2" Grid.Column="1">
                        <PasswordBox x:Name="passBxScnd"
                                     ToolTip="Повторите пароль"
                                     MaxLength="50"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                        <TextBlock x:Name="lblPassSecHitn" Text="Повторите пароль" Style="{DynamicResource HintText}"/>
                    </Grid>

                    <TextBlock Grid.Row="3" Text="Роль *" Style="{DynamicResource FieldLabel}"/>
                    <ComboBox x:Name="comboBxRole" Grid.Row="3" Grid.Column="1"
                              DisplayMemberPath="RoleName"
                              SelectedValuePath="RoleId"
                              ToolTip="Выберите роль"/>

                    <TextBlock Grid.Row="4" Text="Фамилия *" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="txtbxLastName" Grid.Row="4" Grid.Column="1"
                             Tag="Например: Иванов"
                             ToolTip="Введите фамилию (только буквы)"
                             MaxLength="50"
                             classes:InputMask.Mode="Letters"/>

                    <TextBlock Grid.Row="5" Text="Имя *" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="txtbxFirstName" Grid.Row="5" Grid.Column="1"
                             Tag="Например: Алексей"
                             ToolTip="Введите имя (только буквы)"
                             MaxLength="50"
                             classes:InputMask.Mode="Letters"/>

                    <TextBlock Grid.Row="6" Text="Отчество" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="txtbxMiddleName" Grid.Row="6" Grid.Column="1"
                             Tag="Необязательно"
                             ToolTip="Введите отчество, если оно есть"
                             MaxLength="50"
                             classes:InputMask.Mode="Letters"/>

                    <TextBlock Grid.Row="7" Text="E-mail *" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="txtbxEmail" Grid.Row="7" Grid.Column="1"
                             Tag="name@mail.ru"
                             ToolTip="Введите адрес электронной почты"
                             MaxLength="100"/>

                    <TextBlock Grid.Row="8" Text="Телефон *" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="txtbxPhone" Grid.Row="8" Grid.Column="1"
                             Tag="+7 (999) 123-45-67"
                             ToolTip="Введите номер телефона: 10 цифр после +7"
                             MaxLength="18"
                             classes:InputMask.Mode="Phone"/>

                    <TextBlock Grid.Row="9" Text="Дата рождения *" Style="{DynamicResource FieldLabel}"/>
                    <DatePicker x:Name="dpBirthDate" Grid.Row="9" Grid.Column="1"
                                ToolTip="Выберите дату рождения (вам должно быть не меньше 14 лет)"/>
                </Grid>

                <TextBlock Text="* — обязательные поля" Style="{DynamicResource InfoText}"/>

                <Button x:Name="regButton"
                        Content="Зарегистрироваться"
                        Style="{DynamicResource MainButton}"
                        HorizontalAlignment="Center"
                        ToolTip="Создать учётную запись"
                        Click="regButton_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
