<Page x:Class="MarketplaceApp.Pages.ReviewsTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица «Отзывы»">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource FilterBar}">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="280" Tag="Поиск: товар, автор или текст"
                         ToolTip="Введите часть названия товара, ФИО автора или текста отзыва" MaxLength="100"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="RatingBox" Width="190" SelectedIndex="0"
                          ToolTip="Фильтр по оценке" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Все оценки"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="1"/>
                </ComboBox>
                <ComboBox x:Name="SortBox" Width="230" SelectedIndex="0"
                          ToolTip="Порядок сортировки" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Сначала новые"/>
                    <ComboBoxItem Content="Сначала старые"/>
                    <ComboBoxItem Content="Оценка: по убыванию"/>
                    <ComboBoxItem Content="Оценка: по возрастанию"/>
                </ComboBox>
                <Button Content="Очистить фильтр" Style="{DynamicResource SecondaryButton}"
                        ToolTip="Сбросить поиск, фильтр и сортировку" Click="ClearFiltersButton_Click"/>
                <TextBlock x:Name="CountText" Style="{DynamicResource InfoText}"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="DataGridReview" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding Products.ProductName}" Width="200"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Users.FIO}" Width="190"/>
                <DataGridTextColumn Header="Оценка" Binding="{Binding Rating}" Width="75"/>
                <DataGridTextColumn Header="Текст отзыва" Binding="{Binding ReviewText}" Width="*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding ReviewDate, StringFormat='dd.MM.yyyy'}" Width="95"/>
                <DataGridCheckBoxColumn Header="Опубликован" Binding="{Binding IsPublished}" Width="105"/>
                <DataGridTemplateColumn Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Style="{DynamicResource MainButton}"
                                    ToolTip="Редактировать данные" Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{DynamicResource FilterBar}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="ButtonAdd" DockPanel.Dock="Left" Content="Добавить"
                        Style="{DynamicResource MainButton}" ToolTip="Добавить отзыв" Click="ButtonAdd_Click"/>
                <Button x:Name="ButtonDel" DockPanel.Dock="Right" Content="Удалить"
                        Style="{DynamicResource DangerButton}" ToolTip="Удалить выделенные отзывы" Click="ButtonDel_Click"/>
                <Button x:Name="ButtonPublish" Content="Скрыть / показать"
                        Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Center"
                        ToolTip="Скрыть опубликованные или опубликовать скрытые выделенные отзывы"
                        Click="ButtonPublish_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
