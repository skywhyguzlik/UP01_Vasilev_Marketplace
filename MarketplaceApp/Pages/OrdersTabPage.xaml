<Page x:Class="MarketplaceApp.Pages.OrdersTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица «Заказы»">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource FilterBar}">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="280" Tag="Поиск: номер заказа или покупатель"
                         ToolTip="Введите номер заказа или часть ФИО покупателя" MaxLength="100"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="StatusBox" Width="210" DisplayMemberPath="StatusName"
                          ToolTip="Фильтр по статусу заказа" SelectionChanged="Filter_SelectionChanged"/>
                <ComboBox x:Name="SortBox" Width="230" SelectedIndex="0"
                          ToolTip="Порядок сортировки" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Сначала новые"/>
                    <ComboBoxItem Content="Сначала старые"/>
                    <ComboBoxItem Content="Сумма: по убыванию"/>
                    <ComboBoxItem Content="Сумма: по возрастанию"/>
                </ComboBox>
                <Button Content="Очистить фильтр" Style="{DynamicResource SecondaryButton}"
                        ToolTip="Сбросить поиск, фильтр и сортировку" Click="ClearFiltersButton_Click"/>
                <TextBlock x:Name="CountText" Style="{DynamicResource InfoText}"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="DataGridOrder" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding OrderId}" Width="50"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat='dd.MM.yyyy HH:mm'}" Width="125"/>
                <DataGridTextColumn Header="Покупатель" Binding="{Binding Users.FIO}" Width="*"/>
                <DataGridTextColumn Header="Пункт выдачи" Binding="{Binding PickupPoints.FullAddress}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding OrderStatuses.StatusName}" Width="95"/>
                <DataGridTextColumn Header="Оплата" Binding="{Binding PaymentMethod}" Width="130"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat=N2}" Width="95"/>
                <DataGridTextColumn Header="Доставка" Binding="{Binding DeliveryDate, StringFormat='dd.MM.yyyy'}" Width="90"/>
                <DataGridTemplateColumn Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Style="{DynamicResource MainButton}"
                                    ToolTip="Редактировать данные" Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{DynamicResource FilterBar}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="ButtonAdd" DockPanel.Dock="Left" Content="Добавить"
                        Style="{DynamicResource MainButton}" ToolTip="Добавить заказ" Click="ButtonAdd_Click"/>
                <Button x:Name="ButtonDel" DockPanel.Dock="Right" Content="Удалить"
                        Style="{DynamicResource DangerButton}" ToolTip="Удалить выделенные заказы" Click="ButtonDel_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ComboBox x:Name="NewStatusBox" Width="200" DisplayMemberPath="StatusName"
                              ToolTip="Новый статус для выделенных заказов"/>
                    <Button x:Name="ButtonStatus" Content="Сменить статус" Style="{DynamicResource SecondaryButton}"
                            ToolTip="Установить выбранный статус выделенным заказам" Click="ButtonStatus_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Page>
