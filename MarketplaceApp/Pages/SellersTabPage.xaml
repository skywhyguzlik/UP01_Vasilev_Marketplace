<Page x:Class="MarketplaceApp.Pages.SellersTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Таблица «Продавцы»">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource FilterBar}">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="280" Tag="Поиск: магазин, компания или ИНН"
                         ToolTip="Введите часть названия магазина, компании или ИНН" MaxLength="100"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="VerifiedBox" Width="210" SelectedIndex="0"
                          ToolTip="Фильтр по проверке продавца" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Все продавцы"/>
                    <ComboBoxItem Content="Только проверенные"/>
                    <ComboBoxItem Content="Только непроверенные"/>
                </ComboBox>
                <ComboBox x:Name="SortBox" Width="230" SelectedIndex="0"
                          ToolTip="Порядок сортировки" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Магазин: А → Я"/>
                    <ComboBoxItem Content="Магазин: Я → А"/>
                    <ComboBoxItem Content="Рейтинг: по убыванию"/>
                    <ComboBoxItem Content="Рейтинг: по возрастанию"/>
                </ComboBox>
                <Button Content="Очистить фильтр" Style="{DynamicResource SecondaryButton}"
                        ToolTip="Сбросить поиск, фильтр и сортировку" Click="ClearFiltersButton_Click"/>
                <TextBlock x:Name="CountText" Style="{DynamicResource InfoText}"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="DataGridSeller" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Магазин" Binding="{Binding ShopName}" Width="130"/>
                <DataGridTextColumn Header="Компания" Binding="{Binding CompanyName}" Width="*"/>
                <DataGridTextColumn Header="ИНН" Binding="{Binding INN}" Width="120"/>
                <DataGridTextColumn Header="Владелец" Binding="{Binding Users.FIO}" Width="190"/>
                <DataGridTextColumn Header="Комиссия, %" Binding="{Binding CommissionPercent, StringFormat=N2}" Width="105"/>
                <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating, StringFormat=N2}" Width="80"/>
                <DataGridCheckBoxColumn Header="Проверен" Binding="{Binding IsVerified}" Width="85"/>
                <DataGridTemplateColumn Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Style="{DynamicResource MainButton}"
                                    ToolTip="Редактировать данные" Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{DynamicResource FilterBar}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="ButtonAdd" DockPanel.Dock="Left" Content="Добавить"
                        Style="{DynamicResource MainButton}" ToolTip="Добавить данные" Click="ButtonAdd_Click"/>
                <Button x:Name="ButtonDel" DockPanel.Dock="Right" Content="Удалить"
                        Style="{DynamicResource DangerButton}" ToolTip="Удалить выделенные строки" Click="ButtonDel_Click"/>
                <TextBlock Style="{DynamicResource InfoText}" HorizontalAlignment="Center"
                           Text="Несколько строк можно выделить с зажатым Ctrl или Shift"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
