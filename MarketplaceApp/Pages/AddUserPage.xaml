<Page x:Class="MarketplaceApp.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:classes="clr-namespace:MarketplaceApp.Classes"
      Title="Пользователь">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{DynamicResource Card}" Width="720" Margin="20" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{DynamicResource TitleText}" HorizontalAlignment="Center"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Логин *" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="TBLogin" Grid.Row="0" Grid.Column="1"
                             Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Латинские буквы и цифры, от 3 символов" ToolTip="Введите логин"
                             MaxLength="50" classes:InputMask.Mode="Latin"/>

                    <TextBlock Grid.Row="1" x:Name="PassLabel" Text="Пароль *" Style="{DynamicResource FieldLabel}"/>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <PasswordBox x:Name="TBPass" MaxLength="50"
                                     ToolTip="Не менее 6 символов, только английская раскладка, хотя бы одна цифра"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                        <TextBlock x:Name="PassHint" Text="Введите пароль" Style="{DynamicResource HintText}"/>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="Роль *" Style="{DynamicResource FieldLabel}"/>
                    <ComboBox x:Name="cmbRole" Grid.Row="2" Grid.Column="1"
                              DisplayMemberPath="RoleName" SelectedValuePath="RoleId"
                              SelectedValue="{Binding RoleId}" ToolTip="Выберите роль"/>

                    <TextBlock Grid.Row="3" Text="Фамилия *" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="TBLastName" Grid.Row="3" Grid.Column="1"
                             Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Например: Иванов" ToolTip="Введите фамилию (только буквы)"
                             MaxLength="50" classes:InputMask.Mode="Letters"/>

                    <TextBlock Grid.Row="4" Text="Имя *" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="TBFirstName" Grid.Row="4" Grid.Column="1"
                             Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Например: Алексей" ToolTip="Введите имя (только буквы)"
                             MaxLength="50" classes:InputMask.Mode="Letters"/>

                    <TextBlock Grid.Row="5" Text="Отчество" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="TBMiddleName" Grid.Row="5" Grid.Column="1"
                             Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Необязательно" ToolTip="Введите отчество, если оно есть"
                             MaxLength="50" classes:InputMask.Mode="Letters"/>

                    <TextBlock Grid.Row="6" Text="E-mail *" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="TBEmail" Grid.Row="6" Grid.Column="1"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Tag="name@mail.ru" ToolTip="Введите адрес электронной почты" MaxLength="100"/>

                    <TextBlock Grid.Row="7" Text="Телефон *" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="TBPhone" Grid.Row="7" Grid.Column="1"
                             Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             Tag="+7 (999) 123-45-67" ToolTip="Введите телефон: 10 цифр после +7"
                             MaxLength="18" classes:InputMask.Mode="Phone"/>

                    <TextBlock Grid.Row="8" Text="Дата рождения *" Style="{DynamicResource FieldLabel}"/>
                    <DatePicker x:Name="DPBirthDate" Grid.Row="8" Grid.Column="1"
                                SelectedDate="{Binding BirthDate}" ToolTip="Выберите дату рождения (от 14 до 100 лет)"/>

                    <CheckBox x:Name="CBActive" Grid.Row="9" Grid.Column="1" Content="Учётная запись активна"
                              IsChecked="{Binding IsActive}"
                              ToolTip="Если снять галочку, пользователь не сможет войти в систему"/>
                </Grid>

                <TextBlock Text="* — обязательные поля" Style="{DynamicResource InfoText}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="ButtonSave" Content="Сохранить" Style="{DynamicResource MainButton}"
                            ToolTip="Сохранить изменения" Click="ButtonSave_Click"/>
                    <Button x:Name="ButtonClean" Content="Очистить" Style="{DynamicResource SecondaryButton}"
                            ToolTip="Очистить поля формы" Click="ButtonClean_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
